  "mutations": [
    {
      "id": "expiry_late",
      "original": "store[key][1] <= t",
      "replacement": "store[key][1] < t",
      "witness": "boundary"
    },
    {
      "id": "ttl_absolute",
      "original": "else t + ttl",
      "replacement": "else ttl",
      "witness": "relative"
    },
    {
      "id": "zero_immortal",
      "original": "None if ttl is None else",
      "replacement": "None if ttl in (None, 0) else",
      "witness": "zero"
    },
    {
      "id": "reverse_ties",
      "original": "(pair[1]['time'], pair[0])",
      "replacement": "(pair[1]['time'], -pair[0])",
      "witness": "stable"
    },
    {
      "id": "input_order",
      "original": "sorted(enumerate(events), key=lambda pair: (pair[1]['time'], pair[0]))",
      "replacement": "list(enumerate(events))",
      "witness": "unordered"
    },
    {
      "id": "ignore_delete",
      "original": "store.pop(key, None)",
      "replacement": "pass",
      "witness": "delete"
    },
    {
      "id": "first_put_wins",
      "original": "store[key] = (event['value'], expiry)",
      "replacement": "if key not in store:\n                store[key] = (event['value'], expiry)",
      "witness": "overwrite"
    },
    {
      "id": "get_refresh",
      "original": "reads.append([t, key, store.get(key, (None, None))[0]])",
      "replacement": "reads.append([t, key, store.get(key, (None, None))[0]])\n            if key in store and store[key][1] is not None:\n                store[key] = (store[key][0], store[key][1] + 1)",
      "witness": "refresh"
    },
    {
      "id": "reverse_live",
      "original": "for key in sorted(store)]",
      "replacement": "for key in sorted(store, reverse=True)]",
      "witness": "lexical"
    },
    {
      "id": "bool_integer",
      "original": "type(value) is int",
      "replacement": "isinstance(value, int)",
      "witness": "boolean"
    }
